---
import { getEntry, render } from 'astro:content'

import BaseLayout from '@/layouts/BaseLayout.astro'
import { config } from '@/site-config'
import type { Locale } from '@/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props as Props
const about = await getEntry('about', locale)

if (!about) {
  throw new Error(`Missing About content for locale: ${locale}`)
}

const { Content } = await render(about)
---

<BaseLayout title={about.data.title} description={about.data.description}>
  <div class="animate mx-auto max-w-3xl">
    <header class="not-prose mb-10 flex flex-col items-center text-center">
      <img
        src={config.site.avatar}
        alt={config.site.author}
        width="128"
        height="128"
        class="mb-5 size-28 rounded-full border border-line object-cover shadow-sm sm:size-32"
      />
      <h1 class="font-serif text-3xl font-semibold">{config.site.author}</h1>
      <p class="mt-3 max-w-2xl text-ink-soft">{about.data.description}</p>
    </header>

    <div class="prose prose-fill">
      <Content />
    </div>
  </div>
</BaseLayout>
