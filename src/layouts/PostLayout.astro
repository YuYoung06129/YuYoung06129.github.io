---
import katexStylesheet from 'katex/dist/katex.min.css?url'
import { Image } from 'astro:assets'
import type { MarkdownHeading } from 'astro'
import { getCollection, type CollectionEntry } from 'astro:content'

import BaseLayout from './BaseLayout.astro'
import Comment from '@/components/Comment.astro'
import Mermaid from '@/components/Mermaid.astro'
import Pageview from '@/components/Pageview.astro'
import TOC from '@/components/TOC.astro'
import { config } from '@/site-config'
import { formatDate, withBase } from '@/utils'
import { getBlogCollection, postLocale, postSlug, postUrl, sortMDByDate } from '@/utils/server'
import { locales, t } from '@/i18n'

interface Props {
  post: CollectionEntry<'blog'>
  headings: MarkdownHeading[]
  minutesRead: number
  hasMath?: boolean
}

const { post, headings, minutesRead, hasMath = false } = Astro.props
const { data } = post
const published = data.publishDate
const updated = data.updatedDate
const locale = postLocale(post.id)
const messages = t(locale)
const dateLocale = locale === 'ko' ? 'ko-KR' : 'en-US'

const slug = postSlug(post.id)
const translationCandidates = await getCollection('blog')
const languageLinks = locales.map((language) => {
  const translated = translationCandidates.find(
    (candidate) => postLocale(candidate.id) === language && postSlug(candidate.id) === slug,
  )
  return {
    language,
    active: language === locale,
    href: translated ? postUrl(translated.id) : undefined,
  }
})

// Neighbour posts (newer / older by publish date)
const allPosts = sortMDByDate(await getBlogCollection(locale))
const index = allPosts.findIndex((p) => p.id === post.id)
const newerPost = index > 0 ? allPosts[index - 1] : undefined
const olderPost =
  index >= 0 && index < allPosts.length - 1 ? allPosts[index + 1] : undefined

const canonical = new URL(postUrl(post.id), Astro.site ?? 'https://example.com')

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: published.toISOString(),
  ...(updated && { dateModified: updated.toISOString() }),
  author: { '@type': 'Person', name: config.site.author },
  mainEntityOfPage: canonical.href,
}
---

<BaseLayout
  title={data.title}
  description={data.description}
  date={published}
  modifiedDate={updated}
  stylesheets={hasMath ? [katexStylesheet] : []}
>
  <!-- Reading progress -->
  <div id="reading-progress" aria-hidden="true"></div>

  <!-- No entrance animation here: the full article appears immediately
       (an opacity-0 fade-in reads as a dark flash on heavy pages). -->
  <div class="mx-auto max-w-[45rem] xl:grid xl:max-w-none xl:grid-cols-[minmax(0,1fr)_12.5rem] xl:gap-10">
    <article class="min-w-0 xl:col-start-1 xl:row-start-1">
      <!-- Post header -->
      <header class="mb-6 xl:mb-9">
        <div class="flex items-start justify-between gap-5">
          <h1 class="min-w-0 font-serif text-3xl font-semibold leading-tight sm:text-4xl">
            {data.draft && <span class="me-2 text-accent">[Draft]</span>}
            {data.title}
          </h1>
          <nav class="not-prose mt-1 flex shrink-0 items-center gap-2 text-sm" aria-label="Post language">
            {languageLinks.map(({ language, active, href }) =>
              href ? (
                <a
                  href={href}
                  hreflang={language}
                  lang={language}
                  aria-current={active ? 'page' : undefined}
                  class="post-language-link lowercase text-ink-soft transition-colors hover:text-accent"
                >
                  {language}
                </a>
              ) : (
                <span
                  lang={language}
                  aria-disabled="true"
                  title={`${language.toUpperCase()} translation unavailable`}
                  class="cursor-not-allowed lowercase text-ink-soft/35"
                >
                  {language}
                </span>
              ),
            )}
          </nav>
        </div>

        <!-- Editorial-style meta: plain muted text, no chips -->
        <div class="mt-5 flex flex-wrap items-baseline gap-x-2 gap-y-1 text-sm text-ink-soft">
          <time datetime={published.toISOString()}>
            {formatDate(published, dateLocale)}
          </time>
          {updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                {messages.updated} {formatDate(updated, dateLocale)}
              </span>
            </>
          )}
          <span aria-hidden="true">·</span>
          <span>
            {minutesRead} {messages.minRead}
          </span>
          {config.pageview.server && (
            <>
              <span aria-hidden="true">·</span>
              <Pageview />
            </>
          )}
          {data.tags.length > 0 && (
            <>
              <span aria-hidden="true">·</span>
              {data.tags.map((tag, i) => (
                <>
                  <a
                    href={withBase(`/tags/${tag}`)}
                    class="link-ink"
                    data-astro-prefetch
                  >
                    #{tag}
                  </a>
                  {i < data.tags.length - 1 && <span class="text-ink-soft/50">/</span>}
                </>
              ))}
            </>
          )}
        </div>
      </header>

      <TOC {headings} variant="mobile" />

      <!-- Cover image (optimized: responsive sizes, eager for LCP, no CLS) -->
      {data.heroImage && (
        <Image
          src={data.heroImage.src}
          alt={data.heroImage.alt ?? data.title}
          widths={[640, 960, 1280]}
          sizes="(min-width: 784px) 720px, (min-width: 640px) calc(100vw - 64px), calc(100vw - 40px)"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="mb-9 h-auto max-h-96 w-full rounded-2xl border border-line object-cover"
        />
      )}

      <!-- Article body -->
      <div class="prose prose-fill">
        <slot />
      </div>
      <Mermaid />

      <!-- Post footer -->
      <footer class="not-prose mt-14 border-t border-line pt-6">
        <p class="font-serif text-sm italic text-ink-soft">{messages.endArticle}</p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <a
            href={withBase('/blog')}
            class="chip"
            data-astro-prefetch
          >
            <span class="i-lucide-arrow-left size-3.5" aria-hidden="true"></span>
            {messages.backBlog}
          </a>
          <a href="#top" class="chip">
            <span class="i-lucide-arrow-up size-3.5" aria-hidden="true"></span>
            {messages.backTop}
          </a>
        </div>

        <!-- Prev / next -->
        {(newerPost || olderPost) && (
          <nav
            class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2"
            aria-label="Post navigation"
          >
            {newerPost && (
              <a
                href={postUrl(newerPost.id)}
                class="paper-card group flex flex-col gap-1 p-4"
                data-astro-prefetch
              >
                <span class="flex items-center gap-1.5 text-xs text-ink-soft">
                  <span
                    class="i-lucide-arrow-left size-3.5 transition-transform duration-300 group-hover:-translate-x-1"
                    aria-hidden="true"
                  />
                  {messages.previous}
                </span>
                <span class="line-clamp-2 text-sm font-medium group-hover:text-accent">
                  {newerPost.data.title}
                </span>
              </a>
            )}
            {olderPost && (
              <a
                href={postUrl(olderPost.id)}
                class="paper-card group flex flex-col gap-1 p-4 sm:text-end"
                data-astro-prefetch
              >
                <span class="flex items-center justify-end gap-1.5 text-xs text-ink-soft sm:flex-row-reverse">
                  <span
                    class="i-lucide-arrow-right size-3.5 transition-transform duration-300 group-hover:translate-x-1"
                    aria-hidden="true"
                  />
                  {messages.next}
                </span>
                <span class="line-clamp-2 text-sm font-medium group-hover:text-accent">
                  {olderPost.data.title}
                </span>
              </a>
            )}
          </nav>
        )}

        {data.comment && <Comment />}
      </footer>
    </article>
    <TOC {headings} variant="desktop" />
  </div>

  <!-- BlogPosting structured data -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  #reading-progress {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    height: 3px;
    background-color: hsl(var(--accent) / 0.85);
    transform-origin: 0 50%;
    transform: scaleX(0);
    pointer-events: none;
  }

  .post-language-link[aria-current='page'] {
    color: hsl(var(--accent) / 1);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
</style>

<script>
  const bar = document.getElementById('reading-progress')
  if (bar) {
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight
      bar.style.transform = `scaleX(${max > 0 ? Math.min(window.scrollY / max, 1) : 0})`
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll()
  }
</script>
