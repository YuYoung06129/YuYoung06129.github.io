---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import BaseLayout from '@/layouts/BaseLayout.astro'
import Pagination from '@/components/Pagination.astro'
import PostCard from '@/components/PostCard.astro'
import { config } from '@/site-config'
import { getBlogCollection, sortMDByDate } from '@/utils/server'
import { prefixedLocales, t, type Locale } from '@/i18n'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const paths = []
  for (const locale of prefixedLocales) {
    const posts = sortMDByDate(await getBlogCollection(locale))
    paths.push(...paginate(posts, { pageSize: config.blog.pageSize, params: { locale } }))
  }
  return paths
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  renderLocale?: Locale
}

const { page, renderLocale } = Astro.props as Props
const locale = renderLocale ?? (Astro.params.locale as Locale)
const messages = t(locale)
const isFirst = page.currentPage === 1
const title = isFirst
  ? messages.blog
  : `${messages.blog} · ${messages.page} ${page.currentPage}`
const totalPages = Math.max(1, page.lastPage)
---

<BaseLayout title={title} description={`${page.total} posts`}>
  <div class="animate not-prose mx-auto max-w-[47.5rem]">
    <header class="mb-8">
      <h1 class="font-serif text-3xl font-semibold">{messages.blog}</h1>
      <p class="mt-2 text-sm text-ink-soft">
        {page.total} {messages.posts} · {messages.page} {page.currentPage} {messages.of}{' '}
        {totalPages}
      </p>
    </header>

    {page.data.length === 0 ? (
      <p class="py-12 text-center text-ink-soft">{messages.noPosts}</p>
    ) : (
      <div class="flex flex-col">
        {page.data.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )}

    <Pagination
      prev={page.url.prev ? { title: messages.previous, url: page.url.prev } : undefined}
      next={page.url.next ? { title: messages.next, url: page.url.next } : undefined}
    />
  </div>
</BaseLayout>
