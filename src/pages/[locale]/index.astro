---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostCard from '@/components/PostCard.astro'
import { SOCIAL_ICONS, withBase } from '@/utils'
import { config } from '@/site-config'
import { getBlogCollection, getUniqueTagsWithCount, sortMDByDate } from '@/utils/server'
import { localePath, prefixedLocales, t, type Locale } from '@/i18n'

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }))
}

interface Props {
  renderLocale?: Locale
}

const { renderLocale } = Astro.props as Props
const locale = renderLocale ?? (Astro.params.locale as Locale)
const messages = t(locale)
const { recentPosts, education = [], skills = [], showTags } = config.home
const introduction = messages.home.intro

const posts = sortMDByDate(await getBlogCollection(locale))
const recent = recentPosts > 0 ? posts.slice(0, Math.min(recentPosts, 5)) : []
const tags = getUniqueTagsWithCount(posts).slice(0, 12)

const socialItems = Object.entries(config.footer.social ?? {}).map(([key, item]) => ({
  ...item,
  icon: SOCIAL_ICONS[key] ?? 'i-lucide-link',
}))
---

<BaseLayout>
  <div class="mx-auto max-w-[47.5rem]">
    <!-- Hero -->
    <div id="content-header" class="not-prose mb-12 border-b border-line pb-10">
      <div class="flex items-center gap-4 sm:gap-5">
        <img
          src={withBase(config.site.avatar)}
          alt={config.site.author}
          width="72"
          height="72"
          loading="eager"
          decoding="async"
          class="size-16 shrink-0 rounded-full border border-line object-cover sm:size-18"
        />
        <div class="min-w-0">
          <h1 class="font-serif text-3xl font-semibold leading-tight text-ink sm:text-4xl">
            {config.site.author}
          </h1>
          {messages.home.tagline && (
            <p class="mt-2 text-xs leading-relaxed tracking-wide text-ink-soft sm:text-sm">
              {messages.home.tagline}
            </p>
          )}
        </div>
      </div>

      {introduction && (
        <div class="mt-5 max-w-2xl space-y-3 text-base leading-relaxed text-ink-soft">
          {introduction
            .split(/\n\s*\n/)
            .filter(Boolean)
            .map((paragraph) => (
              <p>{paragraph}</p>
            ))}
        </div>
      )}

      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
        {messages.home.location && (
          <span class="inline-flex items-center gap-1 text-sm text-ink-soft">
            <span class="i-lucide-map-pin size-3.5" aria-hidden="true" />
            {messages.home.location}
          </span>
        )}
        {socialItems.map((item) => (
          <a
            href={item.url}
            target="_blank"
            rel="noreferrer"
            aria-label={item.label}
            title={item.label}
            class="icon-link size-9"
          >
            <span class={`${item.icon} size-4`} aria-hidden="true" />
          </a>
        ))}
        {
          <a
            href={withBase('/about')}
            class="link-ink inline-flex min-h-9 items-center text-sm"
            data-astro-prefetch
          >
            {messages.home.moreAbout}
          </a>
        }
      </div>
    </div>

    <!-- Recent posts -->
    {recent.length > 0 && (
      <section aria-label="Posts" class="not-prose mb-16">
        <div class="mb-5 flex items-end justify-between">
          <h2 class="font-serif text-xl font-normal">{messages.home.posts}</h2>
          <a
            href={withBase(localePath(locale, '/blog'))}
            class="link-ink text-sm"
            data-astro-prefetch
          >
            {messages.home.morePosts}
          </a>
        </div>
        <div class="flex flex-col">
          {recent.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )}

    <!-- Education -->
    {education.length > 0 && (
      <section
        aria-label="Education"
        class="animate not-prose mb-16"
        style="animation-delay: 120ms"
      >
        <div class="mb-5 flex items-end justify-between">
          <h2 class="font-serif text-xl font-normal">Education</h2>
        </div>
        <div class="paper-card divide-y divide-line overflow-hidden">
          {education.map((item) => (
            <div class="flex flex-col gap-1 px-5 py-4 sm:flex-row sm:items-baseline sm:justify-between">
              <div>
                <p class="font-serif font-semibold leading-snug">{item.school}</p>
                {(item.major || item.degree) && (
                  <p class="mt-0.5 text-sm text-ink-soft">
                    {[item.major, item.degree].filter(Boolean).join(' · ')}
                  </p>
                )}
              </div>
              <p class="shrink-0 font-mono text-xs text-ink-soft sm:ms-6">{item.date}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Skills -->
    {skills.length > 0 && (
      <section
        aria-label="Skills"
        class="animate not-prose mb-16"
        style="animation-delay: 180ms"
      >
        <div class="mb-5 flex items-end justify-between">
          <h2 class="font-serif text-xl font-normal">{messages.home.skills}</h2>
        </div>
        <div class="flex flex-col gap-5">
          {skills.map((group) => (
            <div>
              <h3 class="mb-2 text-sm font-semibold uppercase tracking-widest text-ink-soft">
                {group.title}
              </h3>
              <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-ink-soft">
                {group.items.map((item) => (
                  <span>{item}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Tags (optional) -->
    {showTags && tags.length > 0 && (
      <section
        aria-label="Tags"
        class="animate not-prose mb-16"
        style="animation-delay: 240ms"
      >
        <div class="mb-5 flex items-end justify-between">
          <h2 class="font-serif text-xl font-normal">{messages.tags}</h2>
          <a
            href={withBase(localePath(locale, '/tags'))}
            class="link-ink text-sm"
            data-astro-prefetch
          >
            {locale === 'ko' ? '모든 태그 →' : 'All tags →'}
          </a>
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-2">
          {tags.map(([tag, count]) => (
            <a
              href={withBase(localePath(locale, `/tags/${tag}`))}
              class="tag-link"
              data-astro-prefetch
            >
              #{tag}
              <span class="font-mono text-xs">{count}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
