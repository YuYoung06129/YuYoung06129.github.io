---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { config } from '@/site-config'
import { prefixedLocales, t, type Locale } from '@/i18n'

export function getStaticPaths() {
  return prefixedLocales.map((locale) => ({ params: { locale } }))
}

interface Props {
  renderLocale?: Locale
}

const { renderLocale } = Astro.props as Props
const locale = renderLocale ?? (Astro.params.locale as Locale)
const messages = t(locale)
---

<BaseLayout title={messages.search} description={messages.searchDescription} noindex>
  <div class="animate not-prose mx-auto max-w-2xl">
    <header class="mb-6">
      <h1 class="font-serif text-3xl font-semibold">{messages.search}</h1>
      <p class="mt-2 text-sm text-ink-soft">{messages.searchDescription}</p>
    </header>

    {config.search.enabled ? (
      <>
        <div class="relative">
          <label for="search-input" class="sr-only">
            {messages.search}
          </label>
          <span
            class="i-lucide-search absolute start-3.5 top-1/2 size-4 -translate-y-1/2 text-ink-soft"
            aria-hidden="true"
          />
          <input
            id="search-input"
            type="search"
            placeholder={messages.searchPlaceholder}
            autocomplete="off"
            aria-controls="search-results"
            autofocus
            class="w-full rounded-xl border border-line bg-card px-10 py-3 text-sm text-ink outline-none transition-colors duration-200 placeholder:text-ink-soft/60 focus:border-accent focus:ring-2 focus:ring-accent/20"
          />
        </div>
        <p
          id="search-status"
          role="status"
          aria-live="polite"
          aria-atomic="true"
          class="mt-3 text-sm text-ink-soft"
        />
        <ul id="search-results" class="mt-6 flex flex-col" />
      </>
    ) : (
      <p class="py-10 text-center text-ink-soft">
        Search is disabled in the configuration.
      </p>
    )}
  </div>
</BaseLayout>

<script>
  const BASE = import.meta.env.BASE_URL

  import { searchPosts, type SearchItem } from '@/utils/search'
  import { localeFromPath, t } from '@/i18n'

  const locale = localeFromPath(window.location.pathname)
  const messages = t(locale)

  const input = document.getElementById('search-input') as HTMLInputElement | null
  const status = document.getElementById('search-status') as HTMLElement | null
  const list = document.getElementById('search-results') as HTMLElement | null
  let index: SearchItem[] | null = null
  let loadFailed = false

  if (input && status && list) {
    const escapeHtml = (s: string) =>
      s.replace(
        /[&<>"']/g,
        (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
      )

    const highlight = (text: string, q: string) => {
      const i = text.toLowerCase().indexOf(q)
      if (i < 0) return escapeHtml(text)
      return (
        escapeHtml(text.slice(0, i)) +
        '<mark>' +
        escapeHtml(text.slice(i, i + q.length)) +
        '</mark>' +
        escapeHtml(text.slice(i + q.length))
      )
    }

    const snippet = (item: SearchItem, q: string) => {
      const hay = `${item.description} ${item.content}`
      const i = hay.toLowerCase().indexOf(q)
      if (i < 0) return escapeHtml(item.description)
      const start = Math.max(0, i - 40)
      return (start > 0 ? '…' : '') + highlight(hay.slice(start, i + 140), q) + '…'
    }

    const render = (q: string) => {
      const query = q.trim().toLowerCase()
      if (!query) {
        list!.innerHTML = ''
        status!.textContent = messages.searchPrompt
        return
      }
      if (!index) {
        list!.innerHTML = ''
        status!.textContent = loadFailed ? messages.searchFailed : messages.searchLoading
        return
      }
      const hits = searchPosts(index, query)
      status!.textContent = `${hits.length} ${messages.resultsFound}`
      list!.innerHTML = hits.length
        ? hits
            .map(
              (item) => `
            <li class="post-row">
              <a href="${BASE}${locale === 'ko' ? 'ko/' : ''}blog/${escapeHtml(item.slug.split('/').map(encodeURIComponent).join('/'))}" class="group block">
                <h2 class="font-serif text-xl font-semibold leading-snug transition-colors group-hover:text-accent">${highlight(item.title, query)}</h2>
                <time class="mt-2 block text-xs text-ink-soft tabular-nums">${new Date(item.date).toLocaleDateString()}</time>
                <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-soft">${snippet(item, query)}</p>
                ${
                  item.tags.length
                    ? `<div class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs text-ink-soft">${item.tags
                        .map((t) => `<span>#${escapeHtml(t)}</span>`)
                        .join('')}</div>`
                    : ''
                }
              </a>
            </li>`,
            )
            .join('')
        : `<li class="py-12 text-center text-ink-soft">${messages.noResults}</li>`
    }

    let timer: number | undefined
    input.addEventListener('input', () => {
      window.clearTimeout(timer)
      timer = window.setTimeout(() => render(input.value), 120)
    })

    status.textContent = messages.searchLoading
    fetch(`${BASE}search-index.json`)
      .then((r) => {
        if (!r.ok) throw new Error(`Search index request failed: ${r.status}`)
        return r.json()
      })
      .then((data: SearchItem[]) => {
        index = data.filter((item) => item.locale === locale)
        render(input.value)
      })
      .catch(() => {
        loadFailed = true
        status!.textContent = messages.searchFailed
      })
  }
</script>
