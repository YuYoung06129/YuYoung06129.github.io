---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import BaseLayout from '@/layouts/BaseLayout.astro'
import Pagination from '@/components/Pagination.astro'
import PostCard from '@/components/PostCard.astro'
import { config } from '@/site-config'
import { getBlogCollection, sortMDByDate } from '@/utils/server'
import { prefixedLocales, t, type Locale } from '@/i18n'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const paths = []
  for (const locale of prefixedLocales) {
    const posts = await getBlogCollection(locale)
    const tags = new Set(posts.flatMap((p) => p.data.tags))
    for (const tag of tags) {
      const tagged = sortMDByDate(posts.filter((p) => p.data.tags.includes(tag)))
      paths.push(
        ...paginate(tagged, {
          pageSize: config.blog.pageSize,
          params: { locale, tag },
          props: { tag },
        }),
      )
    }
  }
  return paths
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  tag: string
  renderLocale?: Locale
}

const { page, tag, renderLocale } = Astro.props as Props
const locale = renderLocale ?? (Astro.params.locale as Locale)
const messages = t(locale)
---

<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}`}>
  <div class="animate not-prose mx-auto max-w-[47.5rem]">
    <header class="mb-8">
      <h1 class="font-serif text-3xl font-semibold">
        <span class="text-accent">#{tag}</span>
      </h1>
      <p class="mt-2 text-sm text-ink-soft">
        {page.total} {messages.posts} · {messages.page} {page.currentPage} {messages.of}{' '}
        {Math.max(1, page.lastPage)}
      </p>
    </header>

    {page.data.length === 0 ? (
      <p class="py-12 text-center text-ink-soft">{messages.noTaggedPosts}</p>
    ) : (
      <div class="flex flex-col">
        {page.data.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )}

    <Pagination
      prev={page.url.prev ? { title: messages.previous, url: page.url.prev } : undefined}
      next={page.url.next ? { title: messages.next, url: page.url.next } : undefined}
    />
  </div>
</BaseLayout>
