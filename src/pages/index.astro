---
import Layout from '~/layouts/Layout.astro'
import { getSortedPosts } from '~/utils'
import { getCollection, render } from 'astro:content'
// PostPreview/Pagination/BlockHeader removed from homepage since Latest Posts removed
import HomeBanner from '~/components/HomeBanner.astro'
import siteConfig from '~/site.config'

const home = await getCollection('home')
let HomeContent
let homeAvatarImage
if (home.length > 0) {
  const homeEntry = home[0]
  const { Content } = await render(homeEntry)
  HomeContent = Content
  homeAvatarImage = homeEntry.data.avatarImage
}
const sortedPosts = await getSortedPosts()
// Tags/Series features removed: no longer computing tags/series on the homepage
---

<Layout>
  {
    HomeContent && (
      <HomeBanner avatarImage={homeAvatarImage}>
        <HomeContent />
      </HomeBanner>
    )
  }
  <!-- Series and Tags sections removed -->
  <!-- Latest Posts removed -->
</Layout>

<style is:global>
  a.heading-anchor {
    display: none !important;
  }
</style>
