---
import Layout from '~/layouts/Layout.astro'
import { getSortedPosts } from '~/utils'
import PostPreview from '~/components/PostPreview.astro'

const posts = await getSortedPosts()
---

<Layout title="Posts">
  <section class="mt-2 sm:mt-0">
    <div class="border-0 border-accent/30 bg-accent/6 rounded-xl inline-block py-2.5 pl-3 pr-4 mt-5 md:mt-8">
      <h1 class="text-accent text-2xl font-semibold flex flex-wrap gap-y-2 gap-x-3.5">
        <span>/posts</span>
      </h1>
    </div>
    <div class="mt-6 grid gap-4">
      {posts.map((post) => (
        <PostPreview post={post} />
      ))}
    </div>
  </section>
</Layout>
