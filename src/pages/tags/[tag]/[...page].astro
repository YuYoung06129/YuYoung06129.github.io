---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import TagPage from '../../[locale]/tags/[tag]/[...page].astro'
import { config } from '@/site-config'
import { getBlogCollection, sortMDByDate } from '@/utils/server'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getBlogCollection('en')
  const tags = new Set(posts.flatMap((post) => post.data.tags))
  return [...tags].flatMap((tag) => {
    const tagged = sortMDByDate(posts.filter((post) => post.data.tags.includes(tag)))
    return paginate(tagged, {
      pageSize: config.blog.pageSize,
      params: { tag },
      props: { locale: 'en', tag },
    })
  })
}) satisfies GetStaticPaths

const { page, tag } = Astro.props as {
  page: Page<CollectionEntry<'blog'>>
  tag: string
}
const EnglishTagPage = TagPage as any
---

<EnglishTagPage {page} {tag} renderLocale="en" />
